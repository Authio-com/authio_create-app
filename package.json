{
  "name": "create-authio-app",
  "version": "0.2.1",
  "description": "Scaffold a working app pre-wired to Authio for passwordless, multi-org auth.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-authio-app": "./bin/create-authio-app.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --target node20 --out-dir dist --clean --no-splitting",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "kleur": "^4.1.5",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/authio-com/authio_create-app.git"
  },
  "keywords": [
    "authio",
    "authentication",
    "passkey",
    "webauthn",
    "scaffold",
    "starter"
  ],
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.28.1",
      "postcss": ">=8.5.18"
    }
  }
}
