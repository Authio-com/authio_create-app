{
  "name": "authio/%PROJECT_NAME%",
  "type": "project",
  "description": "Laravel + Authio starter generated by create-authio-app.",
  "license": "MIT",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.61.1",
    "authio/authio": "^0.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
